[Unit]
Description=Bramble logging JSON-RPC proxy (memory-only log)
After=network-online.target
Wants=network-online.target

[Service]
User=bramble
WorkingDirectory=/opt/bramble/rpc-proxy
EnvironmentFile=/etc/bramble/rpc-proxy.env
ExecStart=/usr/bin/node src/index.ts
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
