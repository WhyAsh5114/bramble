# Names only. /etc/bramble/admin.env, or an ignored .env in the repo checkout
# on the admin machine. chmod 600. Never commit values.
BRAMBLE_TAILNET_NAME=
BRAMBLE_TAILNET_REGISTRY=
BRAMBLE_TAILNET_REGISTRY_DEPLOY_BLOCK=
BRAMBLE_RELAY_REGISTRY=
BRAMBLE_RELAY_REGISTRY_DEPLOY_BLOCK=

# SECRET. The dedicated Sepolia endpoint (may carry an API key).
SEPOLIA_RPC_URL=
# SECRET. Operator key that signs ENS writes.
SEPOLIA_PRIVATE_KEY=
# The granter key is decrypted per grant from the Ledger Key Ring file (docs/adr/0001).
# APPROVAL_GRANTER_LABEL=
# BRAMBLE_GRANTER_KEY_RING_PATH=
# Software ring demo only: absolute paths on the admin machine.
# BRAMBLE_RING_CLI=
# BRAMBLE_SOFTWARE_RING_KEY_FILE=
# User-unit deployment: stable Node.js and Bun directories plus /usr/bin:/bin.
# PATH=

# SECRET. Shared demo token that protects the approval service's write routes.
APPROVAL_DEMO_TOKEN=

# Activity feed inputs (demo beats 1, 3 and 5). Without these the console
# still serves requests, but reports Gateway/Payments: not configured.
# BRAMBLED_STATUS_URL must reach the gateway statusapi FROM THE ADMIN PROCESS.
# A gateway loopback URL on another machine needs an approved private forward.
# Do not expose statusapi on the public interface. See deploy/ACTIVITY-SOURCES.md.
# BRAMBLED_STATUS_URL=
# Parent used to match full gateway ENS names to console agent labels.
# APPROVAL_ENS_PARENT=
# JSON array: agentLabel, payerAccountId, budgetAtomic, since.
# Use public payer IDs and a started testnet window; never a payer private key.
# APPROVAL_PAYMENT_AGENTS=
# Optional per-payment display cap; match the worker sidecar (default 100000).
# HEDERA_MAX_PAYMENT_ATOMIC=
