# Names only. /etc/bramble/admin.env, or an ignored .env in the repo checkout
# on the admin machine. chmod 600. Never commit values.
BRAMBLE_TAILNET_NAME=
BRAMBLE_TAILNET_REGISTRY=
BRAMBLE_TAILNET_REGISTRY_DEPLOY_BLOCK=
BRAMBLE_RELAY_REGISTRY=
BRAMBLE_RELAY_REGISTRY_DEPLOY_BLOCK=

# SECRET. The dedicated Sepolia endpoint (may carry an API key).
SEPOLIA_RPC_URL=
# SECRET. Operator key that signs ENS writes.
SEPOLIA_PRIVATE_KEY=
# The granter key is decrypted per grant from the Ledger Key Ring file
# (docs/adr/0001); the file path comes from the admincli, not from here.

# SECRET. Shared demo token that protects the approval service's write routes.
APPROVAL_DEMO_TOKEN=
