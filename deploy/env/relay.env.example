# Names only. One file per relay instance: /etc/bramble/relay-<instance>.env
# (for example relay-relay1.env). No secrets: the payee is a public Hedera
# account id, and the token secret is generated by the relay at each start.
RELAY_PAYEE_ACCOUNT_ID=

# Optional; the unit supplies a default for each (values in deploy/REFERENCE.md).
# A second instance must override the first three so the ports do not collide.
# RELAY_ADDR
# RELAY_SIDECAR_PORT
# RELAY_INTERNAL_PORT
# RELAY_PRICE_PER_BYTE
# RELAY_DATA_HOST
