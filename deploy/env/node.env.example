# Names only. Copy to /etc/bramble/gateway.env or /etc/bramble/worker.env,
# fill in the values on the machine, then chmod 600. Never commit values.
# Lines marked SECRET must never appear in a ticket, a log or the repository.

# --- Mesh identity (public values) ---
BRAMBLE_NODE_LABEL=
BRAMBLE_TAILNET_NAME=
BRAMBLE_TAILNET_REGISTRY=
BRAMBLE_TAILNET_REGISTRY_DEPLOY_BLOCK=
BRAMBLE_RELAY_REGISTRY=
BRAMBLE_RELAY_REGISTRY_DEPLOY_BLOCK=

# --- WireGuard key ---
# SECRET. Written by deploy/scripts/gen-node-key.sh; do not type it by hand.
BRAMBLE_PRIVATE_KEY=

# --- Sepolia reads ---
# The logging proxy URL (public, carries no credential). Nodes never hold the
# dedicated Sepolia endpoint; only the proxy and the admin machine do.
SEPOLIA_RPC_URL=

# --- Node runtime ---
# Optional; the unit supplies a default for each (values in deploy/REFERENCE.md).
# Add a line below only to override.
# BRAMBLE_SIDECAR_DIR
# BRAMBLE_SIDECAR_PORT
# BRAMBLE_LISTEN_PORT
# BRAMBLE_TTL
# BRAMBLE_EXTRA_ARGS   (extra `brambled serve` flags, split on spaces)

# --- W8 (STUN), read by the W8 branch of brambled; leave unset to disable discovery ---
# BRAMBLE_STUN_SERVERS   (host:port list, see deploy/REFERENCE.md)

# --- Hedera payer (nodes that buy rendezvous tokens or relay sessions) ---
HEDERA_CLIENT_ACCOUNT_ID=
# SECRET.
HEDERA_CLIENT_PRIVATE_KEY=
# Optional: HEDERA_MAX_PAYMENT_ATOMIC (default in the unit).

# --- Service name: the gateway offers it (-service); the worker requests it (-forward) ---
BRAMBLE_SERVICE_NAME=
# Optional, gateway machine only: DEMO_SERVICE_PORT (loopback port of demo-service).

# --- Worker machine only ---
# Required on the worker only (add the line, with the gateway's label as the value):
# BRAMBLE_GATEWAY_LABEL
# Optional: BRAMBLE_FORWARD_PORT. The forward is -forward <port>=<gateway label>:<service>.
