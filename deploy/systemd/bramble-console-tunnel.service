[Unit]
Description=Reverse SSH tunnel: approval console (admin loopback 3001) to the relay machine's loopback
After=network-online.target
Wants=network-online.target

[Service]
User=bramble
# RELAY_HOST_ALIAS is an SSH host alias from the bramble user's ~/.ssh/config on the admin machine.
Environment=RELAY_HOST_ALIAS=bramble-relays
ExecStart=/usr/bin/ssh -N -T \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -R 127.0.0.1:3001:127.0.0.1:3001 ${RELAY_HOST_ALIAS}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
