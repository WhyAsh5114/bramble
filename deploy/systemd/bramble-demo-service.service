[Unit]
Description=Bramble demo-service (private staging service, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
User=bramble
Environment=DEMO_SERVICE_PORT=9100
# A value in the env file overrides the default above.
EnvironmentFile=/etc/bramble/gateway.env
ExecStart=/opt/bramble/brambled/bin/demo-service -port ${DEMO_SERVICE_PORT}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
