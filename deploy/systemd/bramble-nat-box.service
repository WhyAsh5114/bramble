[Unit]
Description=Bramble NAT box: namespace and source NAT for the node on this machine
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# NATBOX_MODE is cone or symmetric.
Environment=NATBOX_MODE=cone
ExecStart=/opt/bramble/deploy/scripts/nat-box.sh up ${NATBOX_MODE}
ExecStop=/opt/bramble/deploy/scripts/nat-box.sh down

[Install]
WantedBy=multi-user.target
