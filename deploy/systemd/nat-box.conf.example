# Drop-in that moves a unit into the NAT-box namespace.
# Install as /etc/systemd/system/<unit>.service.d/nat-box.conf, then
# `systemctl daemon-reload` and restart the unit. Gateway machine: install it on
# BOTH bramble-gateway and bramble-demo-service (the gateway dials demo-service on
# its own loopback). Worker machine: bramble-worker.
[Unit]
Requires=bramble-nat-box.service
After=bramble-nat-box.service

[Service]
NetworkNamespacePath=/run/netns/bramble-node
# The host's resolv.conf points at a stub resolver on the host's loopback, which the
# namespace cannot reach. nat-box.sh writes a namespace-specific file.
BindReadOnlyPaths=/etc/netns/bramble-node/resolv.conf:/etc/resolv.conf
