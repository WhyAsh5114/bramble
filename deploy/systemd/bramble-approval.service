[Unit]
Description=Bramble approval service (admin machine; loopback only)
After=network-online.target
Wants=network-online.target

[Service]
User=bramble
EnvironmentFile=/etc/bramble/admin.env
WorkingDirectory=/opt/bramble
ExecStart=/usr/bin/env pnpm --filter @bramble/approval start
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
