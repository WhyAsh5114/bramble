# Copy to .env.local. All values are read at request time, not baked in at
# build time — safe to change without rebuilding mid-demo.

# Base URL of the sidecar belonging to any one node in the tailnet you want
# to watch (sidecar/src/ens/config.ts's SIDECAR_PORT default is 7890). Any
# node's sidecar can resolve any device label in the same tailnet — you only
# need one.
SIDECAR_URL=http://127.0.0.1:7890

# Base URL of this node's own brambled status API (brambled/statusapi) —
# live WireGuard peer connectivity, ping, and recent admission/gateway
# activity. Separate from the sidecar above: brambled's own runtime state,
# not ENS/payment state. Default matches brambled serve's -status-port.
BRAMBLED_STATUS_URL=http://127.0.0.1:7899

# Comma-separated ENS labels to watch on the Devices page (not "vps-demo,
# agent-1.eth" — the same bare labels you'd pass to `brambled serve -peer`).
# Note: relay discovery (the Relays page) is not configured here — this
# dashboard only ever proxies an already-running sidecar's own /relays HTTP
# route (dashboard/src/app/api/sidecar/relays), so BRAMBLE_RELAY_REGISTRY /
# BRAMBLE_RELAY_REGISTRY_DEPLOY_BLOCK belong in *that* sidecar's own env, not
# here.
DEVICE_LABELS=laptop-demo,vps-demo,agent-1
