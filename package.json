{
  "name": "bramble",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "keccak",
      "node-hid",
      "usb"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run lint",
    "format": "prettier --write . && turbo run format",
    "format:check": "prettier --check . && turbo run format:check",
    "test": "turbo run test",
    "dev:dashboard": "turbo run dev --filter @bramble/dashboard",
    "test:access-flow": "cd brambled && go test ./gateway -run TestGate2_3_AgentCannotReachOutsideACL -v",
    "check:no-endpoints": "node scripts/check-no-endpoints.mjs",
    "check:no-local-state": "node scripts/check-no-local-state.mjs",
    "verify": "pnpm format:check && pnpm check:no-endpoints && pnpm check:no-local-state && pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
